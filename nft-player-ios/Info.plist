	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>org.lil.nft-folder</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>nft-folder</string>
			</array>
		</dict>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSMotionUsageDescription</key>
	<string>Animate interactive cards based on how you tilt your device.</string>
