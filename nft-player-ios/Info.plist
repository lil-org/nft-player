			<string>Tap here to leave a quick feedback.</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Something wrong?</string>
			<key>UIApplicationShortcutItemType</key>
			<string>org.lil.nft-folder.feedback</string>
		</dict>
	</array>
