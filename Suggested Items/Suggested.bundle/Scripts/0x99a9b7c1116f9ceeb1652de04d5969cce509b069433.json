  "value": "let hash=tokenData.hash;class Random{constructor(){this.useA=0;let _=function(_){let $=parseInt(_.substr(0,8),16),t=parseInt(_.substr(8,8),16),e=parseInt(_.substr(16,8),16),s=parseInt(_.substr(24,8),16);return function(){e|=0;let _=(($|=0)+(t|=0)|0)+(s|=0)|0;return s=s+1|0,$=t^t>>>9,t=e+(e<<3)|0,e=(e=e<<21|e>>>11)+_|0,(_>>>0)/4294967296}};this.prngA=new _(tokenData.hash.substr(2,32)),this.prngB=new _(tokenData.hash.substr(34,32));for(let $=0;$<1e6;$+=2)this.prngA(),this.prngB()}RD(){return this.useA=!this.useA,this.useA?this.prngA():this.prngB()}RN(_,$){return _+($-_)*this.RD()}RI(_,$){return Math.floor(this.RN(_,$+1))}RB(_){return this.RD()<.01*_}RC(_){return _[this.RI(0,_.length-1)]}}let R=new Random,DS=1e3,SN=0,ST=200,VW=36,VH=VW/1.5,WC=0,v,SP,HT,D,M,IS,CM=1,thrsh=75;SZ();let PO=[\"I don't know much about minds, but I think\",\"my brain must have something to do with my body.\",\"Body and brain live inside each other's cells,\",\"exchange info, intermingle.\",\"Every single cell has a mind of its own,\",\"teams up, plays tricks on us every day.\",\"A mind of its own knows no bounds,\",\"only asks for more than it has ever known.\",\"I think about my brain, how it curves and bends,\",\"thoughts turning toward and away from attention,\",\"how flesh and feeling flow in unison.\",\"All right, then: a brain of its own\",\"lives in a kind of stillness that moves,\",\"like living in a mother's womb.\",\"What do you mean?\",\"Let's reach some kind of understanding:\",\"The body is always in motion, in motion, in motion.\",\"The mind is always emotion, emotion, emotion.\",\"Let's turn the mind and body on their heads,\",\"look at the universe from within.\",\"Let's move our minds!\",\"Let's change our bodies!\",\"Let's rethink ourselves!\",\"Let's not think of ourselves as minds\",\"but as embodied realities.\",\"Let's think of ourselves as thinking limbs,\",\"walking thoughts, wandering wonder,\",\"organs that reach and leap and ponder.\",\"Let's not think only of ourselves but also of others.\",\"Let's grab words, pose questions in interesting shapes,\",\"perform letterforms that turn on a verse,\",\"sing, dance, practice, rehearse.\",\"Let's do this all on our own together,\",\"traveling without moving, like a forest of trees,\",\"at home in our bodies, our bodies home.\",\"Let's entwine language into poems.\",\"Let me show you how I feel, move, listen:\",\"Watch. Pause. Play. Mirror. Reflect!\",\"Murmur. Mobilize. Talk. Act. React!\",\"Breathe. Laugh. Eat. Slump. Repeat!\",\"Move while you still can, always move\",\"in the right circles, move in and out of sight.\",\"Careful! Careful! Careful! Careful!\",\"Take care of the incorporeal.\",\"Let the body do the mind a world of good:\",\"balance on one knee, then the other.\",\"Bend to your own will.\",\"Look into my watchful, watchful eye.\",\"Don't look away, don't drop, don't flinch!\",\"Don't lose that gaze, don't let go!\",\"Let's be alive with each other's rhythms:\",\"trillions of cells going a mile a minute.\",\"The mind moves at the speed of dreams.\",\"Hold on! Hold on! Hold on!\",\"Hold on to any idea you can feel\",\"coming to a rest in your mind.\",\"I like to think of my brain as a hand,\",\"palm of my soul, fragile nerve bundle.\",\"I think about my brain as I hold my heart\",\"in both hands - a private thing, a pulsing secret.\",\"It fills my palms and bones with heat.\",\"The world is full of heartbeat.\",\"I am trying to hold it all together.\",\"I am just dying to make my big move,\",\"to wave my hands frantically at the sky,\",\"break the spell that holds us back\",\"from all we can feel and touch.\",\"Enough! Enough! Too much! Too much!\",\"Too little time to feel it all, says my mind.\",\"Still, I love my body,\",\"this body that moves me to tears.\",\"I was born for this body of mine.\"],TXT=\"\",FullMo,TV=0,SS,ML=TXT.charAt(TV),ANI=[],WD=1,TLS=0,NW=0,CRV=0,HSH=0,SHDW=0,WA=[],PN,BN,MPL,TPL,BGC,BGN,OL=0,anidar,display,PA=0,LG=0,palettes=[[[255,0,25